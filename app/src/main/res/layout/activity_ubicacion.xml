<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="150dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#D92E1C15"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:strokeColor="#D4B28C"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="Ubicación de la empresa"
                    android:textColor="#D4B28C"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerEmpresa"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Ver en Google Maps"
            android:textColor="#2E1C15"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#D4B28C"
            app:cornerRadius="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMiUbicacion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Mi ubicación actual"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#CC2E1C15"
            app:cornerRadius="12dp"
            app:strokeColor="#D4B28C"
            app:strokeWidth="1.5dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComoLlegar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Cómo llegar"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#CC2E1C15"
            app:cornerRadius="12dp"
            app:strokeColor="#D4B28C"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#D92E1C15"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="#D4B28C"
            app:strokeWidth="1.5dp">

            <TextView
                android:id="@+id/tvMiUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:text="Pulse “Mi ubicación actual” para ver su posición y la distancia a la empresa."
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarEmpresa"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Editar ubicación de la empresa (ADMIN)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#CC2E1C15"
            app:cornerRadius="12dp"
            app:strokeColor="#D4B28C"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Volver"
            android:textColor="#D4B28C"
            app:backgroundTint="#D92E1C15"
            app:cornerRadius="12dp"
            app:strokeColor="#D4B28C"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</ScrollView>
