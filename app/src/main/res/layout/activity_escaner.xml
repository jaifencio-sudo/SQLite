<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="150dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#D92E1C15"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:strokeColor="#D4B28C"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="Buscar por código de barras"
                    android:textColor="#D4B28C"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Escanee con la cámara o escriba el código"
                    android:textColor="#D7CCC8"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscanear"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Escanear con la cámara"
            android:textColor="#2E1C15"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#D4B28C"
            app:cornerRadius="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="o escriba el código"
            app:boxStrokeColor="#D4B28C"
            app:boxStrokeWidth="1.5dp"
            app:hintTextColor="#D4B28C">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#A1887F" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscarManual"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Buscar manualmente"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#CC2E1C15"
            app:cornerRadius="12dp"
            app:strokeColor="#D4B28C"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#D92E1C15"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="#D4B28C"
            app:strokeWidth="1.5dp">

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:text="Escanee un producto para ver su información"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrear"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Crear producto con este código"
            android:textColor="#2E1C15"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#D4B28C"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAsignar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Asociar código a un producto"
            android:textColor="#2E1C15"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#D4B28C"
            app:cornerRadius="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntrada"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Registrar entrada"
            android:textColor="#2E1C15"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#D4B28C"
            app:cornerRadius="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalida"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Registrar salida"
            android:textColor="#2E1C15"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#D4B28C"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Volver"
            android:textColor="#D4B28C"
            app:backgroundTint="#D92E1C15"
            app:cornerRadius="12dp"
            app:strokeColor="#D4B28C"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</ScrollView>
